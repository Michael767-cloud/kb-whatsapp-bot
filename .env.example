# Required for webhook verification handshake
VERIFY_TOKEN=replace_with_secure_verify_token

# Required for outgoing WhatsApp messages
WHATSAPP_TOKEN=replace_with_meta_access_token
PHONE_NUMBER_ID=replace_with_phone_number_id

# Optional
PORT=3000
# Keep this on a currently supported WhatsApp Cloud API version.
GRAPH_API_VERSION=v20.0
SQLITE_DB_PATH=./data/kb-assistant.sqlite
